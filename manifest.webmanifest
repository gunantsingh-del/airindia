    { "src": "assets/img/vaic-mini-colour.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/vaic-mini-colour.png", "sizes": "180x180", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/vaic-mini-colour.png", "sizes": "167x167", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/vaic-mini-colour.png", "sizes": "152x152", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/vaic-mini-colour.png", "sizes": "120x120", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
