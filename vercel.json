{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/AIVA-Setup.exe",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"AIVA-Setup.exe\"" },
        { "key": "Cache-Control",       "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/js/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/assets/css/(.*)\\.css",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    { "source": "/download",       "destination": "/AIVA-Setup.exe", "permanent": false },
    { "source": "/install.exe",    "destination": "/AIVA-Setup.exe", "permanent": false },
    { "source": "/aiva-setup.exe", "destination": "/AIVA-Setup.exe", "permanent": false }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
